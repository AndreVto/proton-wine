+#ifdef __ANDROID__
+/* Report process exit through the callback */
+static void (*wine_android_exit_callback)( void *, int );
+static void *wine_android_exit_context;
+
+DECLSPEC_EXPORT void wine_android_set_exit_callback( void (*callback)( void *, int ), void *context )
+{
+    wine_android_exit_context = context;
+    wine_android_exit_callback = callback;
+}
+
+void wine_android_notify_exit( int status )
+{
+    if (wine_android_exit_callback)
+        wine_android_exit_callback( wine_android_exit_context, status );
+}
