+
+static void drmsync_ensure_handle_slot( unsigned int idx )
+{
+    size_t count;
+    uint32_t *new_handles;
+
+    if (idx < drmsync_handles_count) return;
+    count = drmsync_handles_count ? drmsync_handles_count : 16384;
+    while (count <= idx) count *= 2;
+    if (!(new_handles = realloc( drmsync_handles, count * sizeof(*new_handles) )))
+        fatal_error( "fsync: unable to grow DRM syncobj table\n" );
+    memset( new_handles + drmsync_handles_count, 0,
+            (count - drmsync_handles_count) * sizeof(*new_handles) );
+    drmsync_handles = new_handles;
+    drmsync_handles_count = count;
+}
+
+static uint32_t drmsync_create_syncobj(void)
+{
+    struct drmsync_create create = {0};
+    if (drmsync_ioctl_retry( drmsync_fd, DRMSYNC_IOCTL_CREATE, &create ) == -1)
+        fatal_error( "fsync: DRM_IOCTL_SYNCOBJ_CREATE failed: %s\n", strerror(errno) );
+    return create.handle;
+}
+
+static void drmsync_destroy_syncobj( uint32_t handle )
+{
+    struct drmsync_destroy destroy = { handle, 0 };
+    if (handle && drmsync_ioctl_retry( drmsync_fd, DRMSYNC_IOCTL_DESTROY, &destroy ) == -1)
+        fprintf( stderr, "fsync: DRM syncobj destroy failed for %u: %s\n", handle, strerror(errno) );
+}
+
+static int drmsync_pi_lock( uint32_t *word, uint32_t tid, int *owner_died )
+{
+    for (;;)
+    {
+        uint32_t expected = 0;
+        if (__atomic_compare_exchange_n( word, &expected, tid, 0, __ATOMIC_ACQUIRE, __ATOMIC_RELAXED ))
+        {
+            *owner_died = 0;
+            return 0;
+        }
+
+        if (!syscall( __NR_futex, word, FUTEX_LOCK_PI, 0, NULL, NULL, 0 ))
+        {
+            uint32_t state = __atomic_load_n( word, __ATOMIC_ACQUIRE );
+            *owner_died = !!(state & FUTEX_OWNER_DIED);
+            return 0;
+        }
+
+        if (errno == EINTR || errno == EAGAIN) continue;
+
+        if (errno == ESRCH)
+        {
+            /* ESRCH can mean a dead owner left a stale TID without kernel PI state.
+             * Do not clear it: TID reuse makes ownership impossible to verify. */
+            return -1;
+        }
+        return -1;
+    }
+}
+
+static int drmsync_pi_unlock( uint32_t *word, uint32_t tid )
+{
+    uint32_t expected = tid;
+
+    if (__atomic_compare_exchange_n( word, &expected, 0, 0, __ATOMIC_RELEASE, __ATOMIC_RELAXED )) return 0;
+    return syscall( __NR_futex, word, FUTEX_UNLOCK_PI, 0, NULL, NULL, 0 );
+}
+
+static uint64_t drmsync_query_point( uint32_t handle )
+{
+    struct drmsync_timeline_array query;
+    uint64_t point = 0;
+
+    memset( &query, 0, sizeof(query) );
+    query.handles = (uintptr_t)&handle;
+    query.points = (uintptr_t)&point;
+    query.count_handles = 1;
+    if (drmsync_ioctl_retry( drmsync_fd, DRMSYNC_IOCTL_QUERY, &query ) == -1)
+        fatal_error( "fsync: DRM_IOCTL_SYNCOBJ_QUERY failed: %s\n", strerror(errno) );
+    return point;
+}
+
+static uint32_t drmsync_get_or_create_syncobj( unsigned int shm_idx )
+{
+    struct drmsync_meta *meta;
+    uint32_t handle, tid = drmsync_native_tid();
+    int owner_died;
+
+    meta = drmsync_meta_from_shm( get_shm( shm_idx ) );
+    if (drmsync_pi_lock( &meta->pi_futex, tid, &owner_died ) == -1)
+        fatal_error( "fsync: FUTEX_LOCK_PI failed creating DRM syncobj: %s\n", strerror(errno) );
+
+    drmsync_ensure_handle_slot( shm_idx );
+    handle = drmsync_handles[shm_idx];
+    if (owner_died)
+        __atomic_store_n( &meta->seq, handle ? drmsync_query_point( handle ) : 0, __ATOMIC_SEQ_CST );
+    if (!handle)
+    {
+        if (__atomic_load_n( &meta->flags, __ATOMIC_RELAXED ) & DRMSYNC_META_ACTIVE)
+            fatal_error( "fsync: active DRM metadata without syncobj for shm index %u\n", shm_idx );
+        handle = drmsync_handles[shm_idx] = drmsync_create_syncobj();
+    }
+
+    if (drmsync_pi_unlock( &meta->pi_futex, tid ) == -1)
+        fatal_error( "fsync: FUTEX_UNLOCK_PI failed creating DRM syncobj: %s\n", strerror(errno) );
+    return handle;
+}
+
+int fsync_drm_export_fd( unsigned int shm_idx )
+{
+    struct drmsync_handle args = {0};
+
+    args.handle = drmsync_get_or_create_syncobj( shm_idx );
+    if (drmsync_ioctl_retry( drmsync_fd, DRMSYNC_IOCTL_HANDLE_TO_FD, &args ) == -1) return -1;
+    return args.fd;
+}
