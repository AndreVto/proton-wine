+static void drmsync_signal_point( uint32_t handle, uint64_t point )
+{
+    struct drmsync_timeline_array signal;
+
+    memset( &signal, 0, sizeof(signal) );
+    signal.handles = (uintptr_t)&handle;
+    signal.points = (uintptr_t)&point;
+    signal.count_handles = 1;
+    if (drmsync_ioctl_retry( drmsync_fd, DRMSYNC_IOCTL_TIMELINE_SIGNAL, &signal ) == -1)
+        fatal_error( "fsync: DRM_IOCTL_SYNCOBJ_TIMELINE_SIGNAL failed: %s\n", strerror(errno) );
+}
+
+static void drmsync_publish_recover( struct drmsync_publish *publish )
+{
+    __atomic_store_n( &publish->meta->seq,
+                      publish->handle ? drmsync_query_point( publish->handle ) : 0,
+                      __ATOMIC_SEQ_CST );
+}
+
+static void drmsync_publish_lock( unsigned int shm_idx, struct drmsync_publish *publish )
+{
+    int owner_died;
+
+    memset( publish, 0, sizeof(*publish) );
+    publish->meta = drmsync_meta_from_shm( get_shm( shm_idx ) );
+    publish->tid = drmsync_native_tid();
+    publish->shm_idx = shm_idx;
+
+    if (drmsync_lf_enabled && !(__atomic_load_n( &publish->meta->flags, __ATOMIC_ACQUIRE ) & DRMSYNC_META_ACTIVE))
+    {
+        publish->lock_free = 1;
+        return;
+    }
+
+    if (drmsync_pi_lock( &publish->meta->pi_futex, publish->tid, &owner_died ) == -1)
+        fatal_error( "fsync: FUTEX_LOCK_PI failed: %s\n", strerror(errno) );
+    publish->locked = 1;
+    if (shm_idx < drmsync_handles_count) publish->handle = drmsync_handles[shm_idx];
+    if (owner_died) drmsync_publish_recover( publish );
+}
+
+static void drmsync_publish_signal( struct drmsync_publish *publish )
+{
+    uint32_t flags;
+
+    publish->notify = 1;
+    if (publish->lock_free) return;
+    flags = __atomic_load_n( &publish->meta->flags, __ATOMIC_RELAXED );
+    if (!(flags & DRMSYNC_META_ACTIVE)) return;
+    if (!publish->handle)
+        fatal_error( "fsync: active DRM metadata has no server syncobj\n" );
+    publish->point = __atomic_load_n( &publish->meta->seq, __ATOMIC_SEQ_CST ) + 1;
+    drmsync_signal_point( publish->handle, publish->point );
+}
+
+static void drmsync_publish_unlock( struct drmsync_publish *publish )
+{
+    if (publish->lock_free && publish->notify)
+    {
+        int owner_died;
+
+        __atomic_thread_fence( __ATOMIC_SEQ_CST );
+        /* A waiter may activate DRM notification during the lock-free update. */
+        if (!(__atomic_load_n( &publish->meta->flags, __ATOMIC_ACQUIRE ) & DRMSYNC_META_ACTIVE))
+            goto done;
+        if (drmsync_pi_lock( &publish->meta->pi_futex, publish->tid, &owner_died ) == -1)
+            fatal_error( "fsync: FUTEX_LOCK_PI failed: %s\n", strerror(errno) );
+        publish->locked = 1;
+        if (publish->shm_idx < drmsync_handles_count) publish->handle = drmsync_handles[publish->shm_idx];
+        if (owner_died) drmsync_publish_recover( publish );
+        if (!publish->handle)
+            fatal_error( "fsync: active DRM metadata has no server syncobj\n" );
+        publish->point = __atomic_load_n( &publish->meta->seq, __ATOMIC_SEQ_CST ) + 1;
+        drmsync_signal_point( publish->handle, publish->point );
+    }
+
+done:
+    if (publish->point)
+        __atomic_store_n( &publish->meta->seq, publish->point, __ATOMIC_SEQ_CST );
+    if (publish->locked && drmsync_pi_unlock( &publish->meta->pi_futex, publish->tid ) == -1)
+        fatal_error( "fsync: FUTEX_UNLOCK_PI failed: %s\n", strerror(errno) );
+}
