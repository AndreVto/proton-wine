+    memset( &cap, 0, sizeof(cap) );
+    cap.capability = DRM_CAP_SYNCOBJ;
+    if (drmsync_ioctl_retry( fd, DRMSYNC_IOCTL_GET_CAP, &cap ) == -1 || !cap.value) return 0;
+    memset( &cap, 0, sizeof(cap) );
+    cap.capability = DRM_CAP_SYNCOBJ_TIMELINE;
+    if (drmsync_ioctl_retry( fd, DRMSYNC_IOCTL_GET_CAP, &cap ) == -1 || !cap.value) return 0;
+    return 1;
+}
+
+static int drmsync_open_device(void)
+{
+    struct dirent *entry;
+    unsigned long best_minor = ULONG_MAX;
+    DIR *dir;
+    int best_fd = -1;
+
+    if (!(dir = opendir( "/dev/dri" ))) return -1;
+
+    while ((entry = readdir( dir )))
+    {
+        const char *suffix;
+        unsigned long minor;
+        char *end;
+        char path[PATH_MAX];
+        int fd, len;
+
+        if (strncmp( entry->d_name, "renderD", 7 )) continue;
+        suffix = entry->d_name + 7;
+        if (!*suffix) continue;
+
+        errno = 0;
+        minor = strtoul( suffix, &end, 10 );
+        if (errno || *end || minor < 128 || minor >= best_minor) continue;
+
+        len = snprintf( path, sizeof(path), "/dev/dri/%s", entry->d_name );
+        if (len < 0 || (size_t)len >= sizeof(path)) continue;
+
+        if ((fd = open( path, O_RDWR | O_CLOEXEC )) == -1) continue;
+        if (!drmsync_caps_ok( fd ))
+        {
+            close( fd );
+            continue;
+        }
+
+        if (best_fd >= 0) close( best_fd );
+        best_fd = fd;
+        best_minor = minor;
+    }
+
+    closedir( dir );
+    return best_fd;
+}
+
+static int drmsync_probe_support(void)
+{
+    int fd;
+
+    if ((fd = drmsync_open_device()) == -1) return 0;
+    close( fd );
+    return 1;
+}
