+static BOOL android_direct_present(void)
+{
+    const char *value = getenv( "WINE_ANDROID_DIRECT_PRESENT" );
+    return value && !strcmp( value, "1" );
+}
+
+static BOOL android_surface_control(void)
+{
+    const char *value = getenv( "WINE_ANDROID_SURFACE_CONTROL" );
+    return value && !strcmp( value, "1" );
+}
+
+typedef void (*direct_present_forget_vulkan_func)(uint64_t hwnd, uint64_t owner);
+typedef uint64_t (*direct_present_surface_generation_func)(uint64_t hwnd, uint64_t owner);
+static pthread_once_t android_surface_forget_once = PTHREAD_ONCE_INIT;
+static void *android_direct_present_bridge;
+static direct_present_forget_vulkan_func direct_present_forget_vulkan;
+static direct_present_surface_generation_func direct_present_surface_generation;
+
+static void android_load_surface_forget(void)
+{
+    const char *path = getenv( "WINE_ANDROID_DIRECT_PRESENT_LIB" );
+    if (!path || !*path) return;
+    if (!(android_direct_present_bridge = dlopen( path, RTLD_NOW | RTLD_LOCAL ))) return;
+    direct_present_forget_vulkan = (direct_present_forget_vulkan_func)dlsym(
+            android_direct_present_bridge, "android_direct_present_forget_vulkan" );
+    direct_present_surface_generation = (direct_present_surface_generation_func)dlsym(
+            android_direct_present_bridge, "android_direct_present_surface_generation" );
+}
+
+static void android_forget_surface(HWND hwnd, VkInstance host_instance)
+{
+    const uint64_t owner = (uint64_t)(uintptr_t)host_instance;
+    if (!android_direct_present()) return;
+    pthread_once( &android_surface_forget_once, android_load_surface_forget );
+    if (direct_present_forget_vulkan)
+        direct_present_forget_vulkan( (uint64_t)(uintptr_t)hwnd, owner );
+}
+
+static uint64_t android_surface_generation(HWND hwnd, VkInstance host_instance)
+{
+    const uint64_t owner = (uint64_t)(uintptr_t)host_instance;
+    if (!android_direct_present()) return 0;
+    pthread_once( &android_surface_forget_once, android_load_surface_forget );
+    if (!direct_present_surface_generation) return 0;
+    return direct_present_surface_generation( (uint64_t)(uintptr_t)hwnd, owner );
+}
 
