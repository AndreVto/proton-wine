+static BOOL is_valid_event_handle(HANDLE handle)
+{
+    union
+    {
+        OBJECT_TYPE_INFORMATION type;
+        BYTE storage[1024];
+    } info;
+    static const WCHAR event_type[] = {'E', 'v', 'e', 'n', 't'};
+    NTSTATUS status;
+
+    if (!handle) return FALSE;
+    status = NtQueryObject(handle, ObjectTypeInformation, &info, sizeof(info), NULL);
+    if (status) return FALSE;
+    return info.type.TypeName.Buffer && info.type.TypeName.Length == sizeof(event_type) &&
+           !memcmp(info.type.TypeName.Buffer, event_type, sizeof(event_type));
+}
+
+static NTSTATUS aaudio_set_event_handle(void *args)
+{
+    struct set_event_handle_params *params = args;
+    struct aaudio_stream *stream = stream_from_handle(params->stream);
+
+    if (!stream) { params->result = AUDCLNT_E_DEVICE_INVALIDATED; return STATUS_SUCCESS; }
+
+    pthread_mutex_lock(&stream->mutex);
+    if (stream_endpoint_invalidated(stream))
+        params->result = AUDCLNT_E_DEVICE_INVALIDATED;
+    else if (!(stream->flags & AUDCLNT_STREAMFLAGS_EVENTCALLBACK))
+        params->result = AUDCLNT_E_EVENTHANDLE_NOT_EXPECTED;
+    else if (stream->event)
+        params->result = HRESULT_FROM_WIN32(ERROR_INVALID_NAME);
+    else if (!is_valid_event_handle(params->event))
+        params->result = E_INVALIDARG;
+    else
+    {
+        stream->event = params->event;
+        params->result = S_OK;
+    }
+    pthread_mutex_unlock(&stream->mutex);
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS aaudio_set_sample_rate(void *args)
+{
+    struct set_sample_rate_params *params = args;
+    struct aaudio_stream *stream = stream_from_handle(params->stream);
