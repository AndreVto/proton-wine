+static NTSTATUS aaudio_set_volumes(void *args)
+{
+    struct set_volumes_params *params = args;
+    struct aaudio_stream *stream = stream_from_handle(params->stream);
+    unsigned int i;
+    if (!stream) return STATUS_SUCCESS;
+    pthread_mutex_lock(&stream->mutex);
+    if (!stream_endpoint_invalidated(stream))
+    {
+        for (i = 0; i < stream->channels; ++i)
+        {
+            float gain = params->volumes[i] * params->master_volume * params->session_volumes[i];
+            __atomic_store(&stream->volumes[i], &gain, __ATOMIC_RELAXED);
+        }
+    }
+    pthread_mutex_unlock(&stream->mutex);
+    return STATUS_SUCCESS;
+}
