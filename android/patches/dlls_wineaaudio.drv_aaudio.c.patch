+static NTSTATUS aaudio_get_latency(void *args)
+{
+    struct get_latency_params *params = args;
+    struct aaudio_stream *stream = stream_from_handle(params->stream);
+    int32_t native_frames;
+
+    if (!stream) { params->result = AUDCLNT_E_DEVICE_INVALIDATED; return STATUS_SUCCESS; }
+    pthread_mutex_lock(&stream->mutex);
+    if (stream_endpoint_invalidated(stream)) { params->result = AUDCLNT_E_DEVICE_INVALIDATED; goto done; }
+
+    native_frames = stream->native ? AAudioStream_getBufferSizeInFrames(stream->native) : 0;
+    if (native_frames <= 0 && stream->native) native_frames = AAudioStream_getFramesPerBurst(stream->native);
+    if (native_frames <= 0) native_frames = stream->period_frames;
+    *params->latency = (REFERENCE_TIME)((UINT64)native_frames * 10000000 / stream->rate);
+    params->result = S_OK;
+
+done:
+    pthread_mutex_unlock(&stream->mutex);
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS aaudio_get_current_padding(void *args)
+{
+    struct get_current_padding_params *params = args;
+    struct aaudio_stream *stream = stream_from_handle(params->stream);
+    if (!stream) { params->result = AUDCLNT_E_DEVICE_INVALIDATED; return STATUS_SUCCESS; }
+    pthread_mutex_lock(&stream->mutex);
+    if (stream_endpoint_invalidated(stream)) params->result = AUDCLNT_E_DEVICE_INVALIDATED;
+    else
+    {
+        if (stream->flow == eCapture)
+        {
+            UINT64 read_frames = __atomic_load_n(&stream->capture_read_frames, __ATOMIC_ACQUIRE);
+            UINT64 write_frames = __atomic_load_n(&stream->capture_write_frames, __ATOMIC_ACQUIRE);
+            *params->padding = (UINT32)((write_frames - read_frames) / stream->period_frames * stream->period_frames);
+        }
+        else
+        {
+            UINT64 read_frames = __atomic_load_n(&stream->render_read_frames, __ATOMIC_ACQUIRE);
+            UINT64 write_frames = __atomic_load_n(&stream->render_write_frames, __ATOMIC_ACQUIRE);
+            *params->padding = (UINT32)(write_frames - read_frames);
+        }
+        params->result = S_OK;
+    }
+    pthread_mutex_unlock(&stream->mutex);
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS aaudio_get_next_packet_size(void *args)
+{
+    struct get_next_packet_size_params *params = args;
+    struct aaudio_stream *stream = stream_from_handle(params->stream);
+    if (!stream || stream->flow != eCapture) { params->result = AUDCLNT_E_WRONG_ENDPOINT_TYPE; return STATUS_SUCCESS; }
+    pthread_mutex_lock(&stream->mutex);
+    if (stream_endpoint_invalidated(stream)) params->result = AUDCLNT_E_DEVICE_INVALIDATED;
+    else
+    {
+        UINT64 read_frames = __atomic_load_n(&stream->capture_read_frames, __ATOMIC_ACQUIRE);
+        UINT64 write_frames = __atomic_load_n(&stream->capture_write_frames, __ATOMIC_ACQUIRE);
+        *params->frames = write_frames - read_frames >= stream->period_frames ? stream->period_frames : 0;
+        params->result = S_OK;
+    }
+    pthread_mutex_unlock(&stream->mutex);
+    return STATUS_SUCCESS;
+}
