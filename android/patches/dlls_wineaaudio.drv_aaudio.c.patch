+static NTSTATUS aaudio_test_connect(void *args)
+{
+    struct test_connect_params *params = args;
+    AAudioStreamBuilder *builder = NULL;
+    AAudioStream *stream = NULL;
+    aaudio_result_t result;
+
+    params->priority = Priority_Unavailable;
+
+    pthread_mutex_lock(&aaudio_lifecycle_mutex);
+
+    result = AAudio_createStreamBuilder(&builder);
+    if (result != AAUDIO_OK || !builder) goto done;
+
+    configure_builder(builder, eRender, DEFAULT_RATE, DEFAULT_RENDER_CHANNELS, TRUE, AAUDIO_UNSPECIFIED);
+    result = AAudioStreamBuilder_openStream(builder, &stream);
+    AAudioStreamBuilder_delete(builder);
+    builder = NULL;
+
+    if (result == AAUDIO_OK && stream)
+        params->priority = Priority_Preferred;
+
+done:
+    if (stream) AAudioStream_close(stream);
+    if (builder) AAudioStreamBuilder_delete(builder);
+    pthread_mutex_unlock(&aaudio_lifecycle_mutex);
+    return STATUS_SUCCESS;
+}
