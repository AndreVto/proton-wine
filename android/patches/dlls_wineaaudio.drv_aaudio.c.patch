+static NTSTATUS aaudio_get_frequency(void *args)
+{
+    struct get_frequency_params *params = args;
+    struct aaudio_stream *stream = stream_from_handle(params->stream);
+    if (!stream) { params->result = AUDCLNT_E_DEVICE_INVALIDATED; return STATUS_SUCCESS; }
+    pthread_mutex_lock(&stream->mutex);
+    if (stream_endpoint_invalidated(stream)) params->result = AUDCLNT_E_DEVICE_INVALIDATED;
+    else
+    {
+        *params->freq = stream->rate;
+        if (stream->share == AUDCLNT_SHAREMODE_SHARED) *params->freq *= stream->frame_size;
+        params->result = S_OK;
+    }
+    pthread_mutex_unlock(&stream->mutex);
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS aaudio_get_position(void *args)
+{
+    struct get_position_params *params = args;
+    struct aaudio_stream *stream = stream_from_handle(params->stream);
+    UINT64 frames;
+
+    if (!stream) { params->result = AUDCLNT_E_DEVICE_INVALIDATED; return STATUS_SUCCESS; }
+
+    pthread_mutex_lock(&stream->mutex);
+    if (stream_endpoint_invalidated(stream))
+    {
+        params->result = AUDCLNT_E_DEVICE_INVALIDATED;
+        pthread_mutex_unlock(&stream->mutex);
+        return STATUS_SUCCESS;
+    }
+
+    audio_clock_update(stream);
+    frames = stream->clock_position_frames;
+    *params->pos = (stream->share == AUDCLNT_SHAREMODE_EXCLUSIVE || params->device)
+                   ? frames : frames * stream->frame_size;
+    if (params->qpctime)
+        *params->qpctime = stream->started && stream->clock_has_timestamp && stream->clock_qpc_100ns
+                           ? stream->clock_qpc_100ns : audio_clock_qpc_now();
+    params->result = S_OK;
+    pthread_mutex_unlock(&stream->mutex);
+    return STATUS_SUCCESS;
+}
