+static void make_container_id(UINT64 key, GUID *guid)
+{
+    static const GUID base =
+        {0xa4aa8179, 0x4bb0, 0x4d8b, {0x96, 0x10, 0xe5, 0x2c, 0x3e, 0xb8, 0x15, 0x21}};
+
+    *guid = base;
+    if (!key) return;
+    guid->Data1 ^= (UINT32)key;
+    guid->Data2 ^= (UINT16)(key >> 32);
+    guid->Data3 ^= (UINT16)(key >> 48);
+}
+
+static UINT make_device_path(const char *device, EDataFlow flow, WCHAR *path, UINT capacity)
+{
+    static const WCHAR render_default[] = {'{','1','}','.','R','O','O','T','\\','M','E','D','I','A','\\','A','A','U','D','I','O','_','R','E','N','D','E','R',0};
+    static const WCHAR capture_default[] = {'{','1','}','.','R','O','O','T','\\','M','E','D','I','A','\\','A','A','U','D','I','O','_','C','A','P','T','U','R','E',0};
+    const WCHAR *default_path = flow == eCapture ? capture_default : render_default;
+    char ascii[96];
+    UINT64 key;
+    UINT length, i;
+
+    if (!parse_device_key(device, flow, &key) || !key)
+    {
+        length = lstrlenW(default_path);
+        if (path && capacity > length)
+            memcpy(path, default_path, (length + 1) * sizeof(WCHAR));
+        return length;
+    }
+
+    snprintf(ascii, sizeof(ascii), "{1}.ROOT\\MEDIA\\AAUDIO_%s\\%016llx",
+             flow == eCapture ? "CAPTURE" : "RENDER", (unsigned long long)key);
+    length = strlen(ascii);
+    if (path && capacity > length)
+    {
+        for (i = 0; i <= length; ++i) path[i] = (unsigned char)ascii[i];
+    }
+    return length;
+}
