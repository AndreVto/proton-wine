+static NTSTATUS wow64_get_prop_value(void *args)
+{
+    struct propvariant32
+    {
+        WORD vt;
+        WORD pad1, pad2, pad3;
+        union
+        {
+            ULONG ulVal;
+            PTR32 ptr;
+            ULARGE_INTEGER uhVal;
+        };
+    } *value32;
+    struct
+    {
+        PTR32 device;
+        EDataFlow flow;
+        PTR32 guid;
+        PTR32 prop;
+        HRESULT result;
+        PTR32 value;
+        PTR32 buffer;
+        PTR32 buffer_size;
+    } *p = args;
+    PROPVARIANT value;
+    struct get_prop_value_params params =
+    {
+        .device = ULongToPtr(p->device),
+        .flow = p->flow,
+        .guid = ULongToPtr(p->guid),
+        .prop = ULongToPtr(p->prop),
+        .value = &value,
+        .buffer = ULongToPtr(p->buffer),
+        .buffer_size = ULongToPtr(p->buffer_size),
+    };
+    NTSTATUS status = aaudio_get_prop_value(&params);
+    p->result = params.result;
+    if (SUCCEEDED(params.result))
+    {
+        value32 = ULongToPtr(p->value);
+        value32->vt = value.vt;
+        switch (value.vt)
+        {
+        case VT_UI4:
+            value32->ulVal = value.ulVal;
+            break;
+        case VT_LPWSTR:
+        case VT_CLSID:
+            value32->ptr = p->buffer;
+            break;
+        default:
+            FIXME("Unhandled vt %04x\n", value.vt);
+            break;
+        }
+    }
+    return status;
+}
