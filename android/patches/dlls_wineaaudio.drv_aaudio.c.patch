+static NTSTATUS aaudio_get_prop_value(void *args)
+{
+    static const GUID audioendpoint_guid =
+        {0x1da5d803, 0xd492, 0x4edd, {0x8c, 0x23, 0xe0, 0xc0, 0xff, 0xee, 0x7f, 0x0e}};
+    static const PROPERTYKEY devicepath_key =
+        {{0xb3f8fa53, 0x0004, 0x438e, {0x90, 0x03, 0x51, 0xa4, 0x6e, 0x13, 0x9b, 0xfc}}, 2};
+    struct get_prop_value_params *params = args;
+    UINT64 device_key = 0;
+    SIZE_T bytes;
+
+    if (!params->prop || !params->value || !params->buffer_size)
+    {
+        params->result = E_INVALIDARG;
+        return STATUS_SUCCESS;
+    }
+
+    parse_device_key(params->device, params->flow, &device_key);
+    PropVariantInit(params->value);
+    if (IsEqualPropertyKey(*params->prop, devicepath_key))
+    {
+        UINT length = make_device_path(params->device, params->flow, NULL, 0);
+        bytes = (length + 1) * sizeof(WCHAR);
+        if (!params->buffer || *params->buffer_size < bytes)
+        {
+            *params->buffer_size = bytes;
+            params->result = E_NOT_SUFFICIENT_BUFFER;
+            return STATUS_SUCCESS;
+        }
+        make_device_path(params->device, params->flow, params->buffer, *params->buffer_size / sizeof(WCHAR));
+        params->value->vt = VT_LPWSTR;
+        params->value->pwszVal = params->buffer;
+        params->result = S_OK;
+        return STATUS_SUCCESS;
+    }
+    if (IsEqualGUID(&params->prop->fmtid, &audioendpoint_guid))
+    {
+        switch (params->prop->pid)
+        {
+        case 0: /* FormFactor */
+            params->value->vt = VT_UI4;
+            params->value->ulVal = params->flow == eCapture ? Microphone : Speakers;
+            params->result = S_OK;
+            return STATUS_SUCCESS;
+        case 3: /* PhysicalSpeakers */
+            if (params->flow != eRender) break;
+            params->value->vt = VT_UI4;
+            params->value->ulVal = KSAUDIO_SPEAKER_STEREO;
+            params->result = S_OK;
+            return STATUS_SUCCESS;
+        }
+    }
+    if (IsEqualPropertyKey(*params->prop, aaudio_devpkey_device_container_id))
+    {
+        GUID container_id;
+
+        bytes = sizeof(GUID);
+        if (!params->buffer || *params->buffer_size < bytes)
+        {
+            *params->buffer_size = bytes;
+            params->result = E_NOT_SUFFICIENT_BUFFER;
+            return STATUS_SUCCESS;
+        }
+        make_container_id(device_key, &container_id);
+        params->value->vt = VT_CLSID;
+        params->value->puuid = params->buffer;
+        *params->value->puuid = container_id;
+        params->result = S_OK;
+        return STATUS_SUCCESS;
+    }
+
+    params->result = E_NOTIMPL;
+    return STATUS_SUCCESS;
+}
