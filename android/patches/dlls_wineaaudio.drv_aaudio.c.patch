+static void *low_alloc(SIZE_T bytes)
+{
+    void *ptr = NULL;
+    SIZE_T size = bytes;
+    if (!bytes) return NULL;
+    if (NtAllocateVirtualMemory(NtCurrentProcess(), &ptr, zero_bits, &size,
+                                MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE))
+        return NULL;
+    return ptr;
+}
+
+static void low_free(void *ptr)
+{
+    SIZE_T size = 0;
+    if (ptr) NtFreeVirtualMemory(NtCurrentProcess(), &ptr, &size, MEM_RELEASE);
+}
+
+static UINT32 frames_from_100ns(REFERENCE_TIME time, UINT32 rate)
+{
+    UINT64 frames;
+    if (time <= 0) return 0;
+    if ((UINT64)time / 10000000 >= UINT32_MAX / rate) return UINT32_MAX;
+    frames = ((UINT64)time / 10000000) * rate;
+    frames += (((UINT64)time % 10000000) * rate + 9999999) / 10000000;
+    return frames > UINT32_MAX ? UINT32_MAX : (UINT32)frames;
+}
+
+static UINT channel_mask(UINT channels)
+{
+    switch (channels)
+    {
+    case 1: return SPEAKER_FRONT_CENTER;
+    case 2: return KSAUDIO_SPEAKER_STEREO;
+    case 4: return KSAUDIO_SPEAKER_QUAD;
+    case 6: return KSAUDIO_SPEAKER_5POINT1_SURROUND;
+    case 8: return KSAUDIO_SPEAKER_7POINT1_SURROUND;
+    default: return 0;
+    }
+}
