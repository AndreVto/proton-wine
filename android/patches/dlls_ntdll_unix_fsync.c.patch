+    query.handles = (uintptr_t)&handle;
+    query.points = (uintptr_t)&point;
+    query.count_handles = 1;
+    if (drmsync_ioctl_retry( drmsync_fd, DRMSYNC_IOCTL_QUERY, &query ) == -1)
+    {
+        ERR( "DRM_IOCTL_SYNCOBJ_QUERY failed: %s.\n", strerror(errno) );
+        abort();
+    }
+    return point;
+}
