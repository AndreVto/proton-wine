+static unsigned int drmsync_prepare_waitall_semaphores( struct fsync *objs, unsigned int count,
+                                                          unsigned int *indices, unsigned int *slots )
+{
+    unsigned int i, j, lock_count = 0;
+
+    for (i = 0; i < count; ++i) slots[i] = ~0u;
+
+    /* Lock unique semaphores in shm_idx order to avoid WaitAll deadlocks. */
+    for (i = 0; i < count; ++i)
+    {
+        if (objs[i].type != FSYNC_SEMAPHORE) continue;
+        for (j = 0; j < lock_count; ++j)
+            if (objs[indices[j]].shm_idx == objs[i].shm_idx) break;
+        if (j != lock_count) continue;
+        while (j && objs[indices[j - 1]].shm_idx > objs[i].shm_idx)
+        {
+            indices[j] = indices[j - 1];
+            --j;
+        }
+        indices[j] = i;
+        ++lock_count;
+    }
+
+    for (i = 0; i < count; ++i)
+    {
+        if (objs[i].type != FSYNC_SEMAPHORE) continue;
+        for (j = 0; j < lock_count; ++j)
+            if (objs[indices[j]].shm_idx == objs[i].shm_idx)
+            {
+                slots[i] = j;
+                break;
+            }
+        assert( slots[i] != ~0u );
+    }
+    return lock_count;
+}
+
+static void drmsync_lock_waitall_semaphores( struct fsync *objs,
+                                               struct drmsync_publish *publishes,
+                                               unsigned int *indices, unsigned int lock_count,
+                                               uint32_t native_tid, struct drmsync_signal_scope *signal_scope )
+{
+    unsigned int i;
+
+    if (lock_count) drmsync_signal_scope_enter( signal_scope );
+    for (i = 0; i < lock_count; ++i)
+        drmsync_publish_lock_force_tid( &objs[indices[i]], &publishes[i], native_tid, TRUE );
+}
+
+static void drmsync_unlock_waitall_semaphores( struct drmsync_publish *publishes, unsigned int lock_count,
+                                                struct drmsync_signal_scope *signal_scope )
+{
+    while (lock_count) drmsync_publish_unlock( &publishes[--lock_count] );
+    drmsync_signal_scope_leave( signal_scope );
+}
