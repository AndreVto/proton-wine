+static BOOL drmsync_try_acquire_one( struct fsync *obj, HANDLE handle, unsigned int index,
+                                     BOOL waited, int *current_tid,
+                                     NTSTATUS *status, int **wait_addr, int *wait_val )
+{
+    *status = STATUS_PENDING;
+    *wait_addr = NULL;
+    *wait_val = 0;
+
+    switch (obj->type)
+    {
+    case FSYNC_SEMAPHORE:
+    {
+        struct semaphore *semaphore = obj->shm;
+        int current, new;
+
+        new = __atomic_load_n( &semaphore->count, __ATOMIC_SEQ_CST );
+        while ((current = new))
+        {
+            if ((new = __sync_val_compare_and_swap( &semaphore->count, current, current - 1 )) == current)
+            {
+                TRACE( "Woken up by handle %p [%u].\n", handle, index );
+                *status = index;
+                return TRUE;
+            }
+        }
+        *wait_addr = &semaphore->count;
+        *wait_val = 0;
+        return FALSE;
+    }
+    case FSYNC_MUTEX:
+    {
+        struct mutex *mutex = obj->shm;
+        int tid, self = drmsync_current_tid( current_tid );
+
+        if (__atomic_load_n( &mutex->tid, __ATOMIC_SEQ_CST ) == self)
+        {
+            TRACE( "Woken up by handle %p [%u].\n", handle, index );
+            mutex->count++;
+            *status = index;
+            return TRUE;
+        }
+
+        if (!(tid = __sync_val_compare_and_swap( &mutex->tid, 0, self )))
+        {
+            TRACE( "Woken up by handle %p [%u].\n", handle, index );
+            mutex->count = 1;
+            *status = index;
+            return TRUE;
+        }
+        if (tid == ~0 && (tid = __sync_val_compare_and_swap( &mutex->tid, ~0, self )) == ~0)
+        {
+            TRACE( "Woken up by abandoned mutex %p [%u].\n", handle, index );
+            mutex->count = 1;
+            *status = STATUS_ABANDONED_WAIT_0 + index;
+            return TRUE;
+        }
+
+        if (fsync_yield_to_waiters && waited && !mutex->last_pid)
+            __sync_val_compare_and_swap( &mutex->last_pid, 0, current_pid );
+        *wait_addr = &mutex->tid;
+        *wait_val = tid;
+        return FALSE;
+    }
+    case FSYNC_AUTO_EVENT:
+    case FSYNC_AUTO_SERVER:
+    {
+        struct event *event = obj->shm;
+
+        if (__sync_val_compare_and_swap( &event->signaled, 1, 0 ))
+        {
+            TRACE( "Woken up by handle %p [%u].\n", handle, index );
+            *status = index;
+            return TRUE;
+        }
+        *wait_addr = &event->signaled;
+        *wait_val = 0;
+        return FALSE;
+    }
+    case FSYNC_MANUAL_EVENT:
+    case FSYNC_MANUAL_SERVER:
+    case FSYNC_QUEUE:
+    {
+        struct event *event = obj->shm;
+
+        if (__atomic_load_n( &event->signaled, __ATOMIC_SEQ_CST ))
+        {
+            TRACE( "Woken up by handle %p [%u].\n", handle, index );
+            *status = index;
+            return TRUE;
+        }
+        *wait_addr = &event->signaled;
+        *wait_val = 0;
+        return FALSE;
+    }
+    default:
+        ERR( "Invalid type %#x for handle %p.\n", obj->type, handle );
+        abort();
+    }
+}
+
+static BOOL drmsync_object_available( struct fsync *obj, int *current_tid,
+                                      int **wait_addr, int *wait_val )
+{
+    *wait_addr = NULL;
+    *wait_val = 0;
+
+    if (obj->type == FSYNC_MUTEX)
+    {
+        struct mutex *mutex = obj->shm;
+        int tid = __atomic_load_n( &mutex->tid, __ATOMIC_SEQ_CST );
+        if (!tid || tid == ~0 || tid == drmsync_current_tid( current_tid )) return TRUE;
+        *wait_addr = &mutex->tid;
+        *wait_val = tid;
+        return FALSE;
+    }
+    else
+    {
+        struct event *event = obj->shm;
+        if (__atomic_load_n( &event->signaled, __ATOMIC_SEQ_CST )) return TRUE;
+        *wait_addr = &event->signaled;
+        *wait_val = 0;
+        return FALSE;
+    }
+}
