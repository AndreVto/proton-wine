+static int drmsync_prepare_apc( struct fsync *apc_obj )
+{
+    struct ntdll_thread_data *data = ntdll_get_thread_data();
+
+    if (!data->fsync_apc_futex)
+    {
+        unsigned int idx = get_inproc_alert_fd();
+
+        TRACE( "get_inproc_alert_fd() %u.\n", idx );
+        if (!idx) return 0;
+        data->fsync_apc_futex = &((struct event *)get_shm( idx ))->signaled;
+    }
+    if (!data->fsync_apc_drm_handle)
+    {
+        ERR( "Missing DRM syncobj for fsync APC alert.\n" );
+        return 0;
+    }
+
+    apc_obj->type = FSYNC_MANUAL_SERVER;
+    apc_obj->drm_handle = data->fsync_apc_drm_handle;
+    apc_obj->drm_cache = NULL;
+    apc_obj->access = SYNCHRONIZE;
+    apc_obj->shm_idx = 0;
+    apc_obj->shm = data->fsync_apc_futex;
+    return 1;
+}
