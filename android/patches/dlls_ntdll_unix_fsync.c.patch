+static int64_t drmsync_deadline_ns( const struct timespec64 *end, clockid_t clock_id )
+{
+    struct timespec now_clock, now_mono;
+    int64_t sec, nsec, delta;
+
+    if (!end) return INT64_MAX;
+    if (clock_id == CLOCK_MONOTONIC)
+    {
+        if (end->tv_sec >= INT64_MAX / 1000000000LL) return INT64_MAX;
+        return end->tv_sec * 1000000000LL + end->tv_nsec;
+    }
+
+    clock_gettime( CLOCK_REALTIME, &now_clock );
+    clock_gettime( CLOCK_MONOTONIC, &now_mono );
+    sec = end->tv_sec - now_clock.tv_sec;
+    nsec = end->tv_nsec - now_clock.tv_nsec;
+    if (sec > INT64_MAX / 1000000000LL) return INT64_MAX;
+    if (sec < -INT64_MAX / 1000000000LL)
+        delta = INT64_MIN;
+    else
+        delta = sec * 1000000000LL + nsec;
+    if (delta <= 0) return (int64_t)now_mono.tv_sec * 1000000000LL + now_mono.tv_nsec;
+    if (now_mono.tv_sec >= INT64_MAX / 1000000000LL) return INT64_MAX;
+    if (delta > INT64_MAX - ((int64_t)now_mono.tv_sec * 1000000000LL + now_mono.tv_nsec)) return INT64_MAX;
+    return (int64_t)now_mono.tv_sec * 1000000000LL + now_mono.tv_nsec + delta;
+}
+
+static int drmsync_wait( uint32_t *handles, uint64_t *points, unsigned int count, uint32_t flags,
+                         const struct timespec64 *end, clockid_t clock_id )
+{
+    struct drmsync_timeline_wait wait;
+
+    memset( &wait, 0, sizeof(wait) );
+    wait.handles = (uintptr_t)handles;
+    wait.points = (uintptr_t)points;
+    wait.timeout_nsec = drmsync_deadline_ns( end, clock_id );
+    wait.count_handles = count;
+    wait.flags = DRM_SYNCOBJ_WAIT_FLAGS_WAIT_FOR_SUBMIT | flags;
+    return ioctl( drmsync_fd, DRMSYNC_IOCTL_TIMELINE_WAIT, &wait );
+}
+
+static int futex_wait_single_android( int *addr, int val, const struct timespec64 *end, clockid_t clock_id )
+{
+    struct timespec now, rel;
+    long long sec, nsec;
+
+    if (!end) return syscall( __NR_futex, addr, FUTEX_WAIT, val, NULL, NULL, 0 );
+    clock_gettime( clock_id, &now );
+    sec = end->tv_sec - now.tv_sec;
+    nsec = end->tv_nsec - now.tv_nsec;
+    if (nsec < 0) { --sec; nsec += 1000000000LL; }
+    if (sec < 0 || (!sec && !nsec)) { errno = ETIMEDOUT; return -1; }
+    rel.tv_sec = sec;
+    rel.tv_nsec = nsec;
+    return syscall( __NR_futex, addr, FUTEX_WAIT, val, &rel, NULL, 0 );
+}
