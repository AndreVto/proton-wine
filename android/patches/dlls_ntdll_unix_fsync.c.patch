+static NTSTATUS drmsync_wait_ioctl_status( uint32_t *handles, uint64_t *points, unsigned int count,
+                                           uint32_t flags, const struct timespec64 *end, clockid_t clock_id )
+{
+    if (!count) return STATUS_PENDING;
+    if (!drmsync_wait( handles, points, count, flags, end, clock_id )) return STATUS_PENDING;
+    if (errno == ETIME || errno == ETIMEDOUT) return STATUS_TIMEOUT;
+    if (errno == EINTR || errno == EAGAIN) return STATUS_PENDING;
+    ERR( "DRM timeline wait failed: %s.\n", strerror(errno) );
+    return STATUS_NOT_SUPPORTED;
