+NTSTATUS fsync_release_mutex( HANDLE handle, LONG *prev )
+{
+    struct fsync obj;
+    NTSTATUS ret;
+
+    if ((ret = get_object( handle, &obj ))) return ret;
+#ifdef __ANDROID__
+    ret = drmsync_release_mutex_object( &obj, prev );
+#else
+    if (obj.type != FSYNC_MUTEX)
+        ret = STATUS_OBJECT_TYPE_MISMATCH;
+    else
+    {
+        struct mutex *mutex = obj.shm;
+
+        if (mutex->tid != GetCurrentThreadId())
+            ret = STATUS_MUTANT_NOT_OWNED;
+        else
+        {
+            if (prev) *prev = mutex->count;
+            if (!--mutex->count)
+            {
+                __atomic_store_n( &mutex->tid, 0, __ATOMIC_SEQ_CST );
+                futex_wake( &mutex->tid, INT_MAX );
+            }
+            ret = STATUS_SUCCESS;
+        }
+    }
+#endif
+    put_object( &obj );
+    return ret;
+}
