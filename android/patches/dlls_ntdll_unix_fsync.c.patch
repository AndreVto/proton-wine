+static void drmsync_recover( struct drmsync_publish *publish )
+{
+    __atomic_store_n( &publish->meta->seq, drmsync_query_point( publish->handle ), __ATOMIC_SEQ_CST );
+}
+
+static void drmsync_publish_lock_tid_ex( struct fsync *obj, struct drmsync_publish *publish, uint32_t tid,
+                                          BOOL signals_preblocked )
+{
+    int owner_died;
+
+    memset( publish, 0, sizeof(*publish) );
+    publish->meta = drmsync_meta_from_shm( obj->shm );
+    publish->handle = obj->drm_handle;
+    publish->tid = tid;
+    publish->signals_preblocked = signals_preblocked;
+    if (!publish->handle)
+    {
+        ERR( "Missing DRM syncobj for fsync object.\n" );
+        abort();
+    }
+
+    if (drmsync_lf_enabled && !(__atomic_load_n( &publish->meta->flags, __ATOMIC_ACQUIRE ) & DRMSYNC_META_ACTIVE))
+    {
+        publish->lock_free = 1;
+        return;
+    }
+
+    if (!signals_preblocked) drmsync_block_server_signals( publish );
+    if (drmsync_pi_lock( &publish->meta->pi_futex, tid, &owner_died ) == -1)
+    {
+        ERR( "FUTEX_LOCK_PI failed: %s.\n", strerror(errno) );
+        abort();
+    }
+    publish->locked = 1;
+    if (owner_died) drmsync_recover( publish );
+}
+
+static void drmsync_publish_lock( struct fsync *obj, struct drmsync_publish *publish )
+{
+    drmsync_publish_lock_tid_ex( obj, publish, drmsync_native_tid(), FALSE );
+}
+
+static void drmsync_publish_lock_force_tid( struct fsync *obj, struct drmsync_publish *publish, uint32_t tid,
+                                             BOOL signals_preblocked )
+{
+    int owner_died;
+
+    memset( publish, 0, sizeof(*publish) );
+    publish->meta = drmsync_meta_from_shm( obj->shm );
+    publish->handle = obj->drm_handle;
+    publish->tid = tid;
+    if (!publish->handle)
+    {
+        ERR( "Missing DRM syncobj for fsync object.\n" );
+        abort();
+    }
+
+    /* WaitAll semaphore transactions require the PI lock even in LF mode. */
+    if (!signals_preblocked) drmsync_block_server_signals( publish );
+    if (drmsync_pi_lock( &publish->meta->pi_futex, tid, &owner_died ) == -1)
+    {
+        ERR( "FUTEX_LOCK_PI failed: %s.\n", strerror(errno) );
+        abort();
+    }
+    publish->locked = 1;
+    if (owner_died) drmsync_recover( publish );
+}
+
+static void drmsync_publish_signal( struct drmsync_publish *publish )
+{
+    uint32_t flags;
+
+    publish->notify = 1;
+    if (publish->lock_free) return;
+    flags = __atomic_load_n( &publish->meta->flags, __ATOMIC_RELAXED );
+    if (!(flags & DRMSYNC_META_ACTIVE)) return;
+    publish->point = __atomic_load_n( &publish->meta->seq, __ATOMIC_SEQ_CST ) + 1;
+    drmsync_signal_point( publish->handle, publish->point );
+}
+
+static void drmsync_publish_unlock( struct drmsync_publish *publish )
+{
+    if (publish->lock_free && publish->notify)
+    {
+        int owner_died;
+
+        __atomic_thread_fence( __ATOMIC_SEQ_CST );
+        /* A waiter may arm DRM notification during the lock-free update. */
+        if (!(__atomic_load_n( &publish->meta->flags, __ATOMIC_ACQUIRE ) & DRMSYNC_META_ACTIVE))
+            goto done;
+        if (!publish->signals_preblocked) drmsync_block_server_signals( publish );
+        if (drmsync_pi_lock( &publish->meta->pi_futex, publish->tid, &owner_died ) == -1)
+        {
+            ERR( "FUTEX_LOCK_PI failed: %s.\n", strerror(errno) );
+            abort();
+        }
+        publish->locked = 1;
+        if (owner_died) drmsync_recover( publish );
+        publish->point = __atomic_load_n( &publish->meta->seq, __ATOMIC_SEQ_CST ) + 1;
+        drmsync_signal_point( publish->handle, publish->point );
+    }
+
+done:
+    if (publish->point)
+        __atomic_store_n( &publish->meta->seq, publish->point, __ATOMIC_SEQ_CST );
+    if (publish->locked && drmsync_pi_unlock( &publish->meta->pi_futex, publish->tid ) == -1)
+    {
+        ERR( "FUTEX_UNLOCK_PI failed: %s.\n", strerror(errno) );
+        abort();
+    }
+    drmsync_restore_server_signals( publish );
+}
+
+static uint64_t drmsync_snapshot_locked_tid( struct fsync *obj, struct drmsync_publish *publish, uint32_t tid,
+                                              BOOL signals_preblocked )
+{
+    uint32_t flags;
+    int owner_died;
+
+    memset( publish, 0, sizeof(*publish) );
+    publish->meta = drmsync_meta_from_shm( obj->shm );
+    publish->handle = obj->drm_handle;
+    publish->tid = tid;
+    if (!publish->handle)
+    {
+        ERR( "Missing DRM syncobj for fsync object.\n" );
+        abort();
+    }
+    if (!signals_preblocked) drmsync_block_server_signals( publish );
+    if (drmsync_pi_lock( &publish->meta->pi_futex, tid, &owner_died ) == -1)
+    {
+        ERR( "FUTEX_LOCK_PI failed: %s.\n", strerror(errno) );
+        abort();
+    }
+    publish->locked = 1;
+    if (owner_died) drmsync_recover( publish );
+    flags = __atomic_load_n( &publish->meta->flags, __ATOMIC_RELAXED );
+    if (!(flags & DRMSYNC_META_ACTIVE))
+        __atomic_store_n( &publish->meta->flags, flags | DRMSYNC_META_ACTIVE, __ATOMIC_RELEASE );
+    return __atomic_load_n( &publish->meta->seq, __ATOMIC_SEQ_CST );
+}
