+static void drmsync_yield_if_available( struct fsync *obj, int prev_pid, BOOL waited )
+{
+    if (waited) return;
+    switch (obj->type)
+    {
+    case FSYNC_SEMAPHORE:
+        if (__atomic_load_n( &((struct semaphore *)obj->shm)->count, __ATOMIC_SEQ_CST ))
+            try_yield_to_waiters( prev_pid );
+        break;
+    case FSYNC_MUTEX:
+        if (!__atomic_load_n( &((struct mutex *)obj->shm)->tid, __ATOMIC_SEQ_CST ))
+            try_yield_to_waiters( prev_pid );
+        break;
+    case FSYNC_AUTO_EVENT:
+    case FSYNC_AUTO_SERVER:
+        if (__atomic_load_n( &((struct event *)obj->shm)->signaled, __ATOMIC_SEQ_CST ))
+            try_yield_to_waiters( prev_pid );
+        break;
+    default:
+        break;
+    }
+}
