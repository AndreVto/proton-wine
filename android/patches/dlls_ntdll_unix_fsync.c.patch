+/* Retry control ioctls on interruption; waits return EINTR for a state rescan. */
+static int drmsync_ioctl_retry( int fd, unsigned long request, void *arg )
+{
+    int ret;
+
+    do ret = ioctl( fd, request, arg );
+    while (ret == -1 && (errno == EINTR || errno == EAGAIN));
+    return ret;
+}
+
+/* Do not let a suspend signal park a thread while it holds a shared PI lock. */
+static void drmsync_block_server_signals( struct drmsync_publish *publish )
+{
+    if (publish->signals_blocked) return;
+    pthread_sigmask( SIG_BLOCK, &server_block_set, &publish->old_sigset );
+    publish->signals_blocked = 1;
+}
+
+static void drmsync_restore_server_signals( struct drmsync_publish *publish )
+{
+    if (!publish->signals_blocked) return;
+    pthread_sigmask( SIG_SETMASK, &publish->old_sigset, NULL );
+    publish->signals_blocked = 0;
+}
+
+struct drmsync_signal_scope
+{
+    sigset_t old_sigset;
+    int active;
+};
+
+static void drmsync_signal_scope_enter( struct drmsync_signal_scope *scope )
+{
+    memset( scope, 0, sizeof(*scope) );
+    pthread_sigmask( SIG_BLOCK, &server_block_set, &scope->old_sigset );
+    scope->active = 1;
+}
+
+static void drmsync_signal_scope_leave( struct drmsync_signal_scope *scope )
+{
+    if (!scope->active) return;
+    pthread_sigmask( SIG_SETMASK, &scope->old_sigset, NULL );
+    scope->active = 0;
+}
