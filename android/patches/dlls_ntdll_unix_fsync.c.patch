+/* With all semaphore PI locks held, signal rollback points before restoring counts. */
+static void drmsync_signal_waitall_semaphore_rollback( struct fsync *objs, unsigned int acquired_count,
+                                                        struct drmsync_publish *publishes,
+                                                        unsigned int *slots )
+{
+    uint32_t handles[MAXIMUM_WAIT_OBJECTS];
+    uint64_t points[MAXIMUM_WAIT_OBJECTS];
+    unsigned int i, signal_count = 0;
+
+    for (i = 0; i < acquired_count; ++i)
+    {
+        struct drmsync_publish *publish;
+        uint32_t flags;
+
+        if (objs[i].type != FSYNC_SEMAPHORE) continue;
+        assert( slots[i] != ~0u );
+        publish = &publishes[slots[i]];
+        assert( publish->locked );
+        if (publish->notify) continue;
+
+        publish->notify = 1;
+        flags = __atomic_load_n( &publish->meta->flags, __ATOMIC_RELAXED );
+        if (!(flags & DRMSYNC_META_ACTIVE)) continue;
+        publish->point = __atomic_load_n( &publish->meta->seq, __ATOMIC_SEQ_CST ) + 1;
+        handles[signal_count] = publish->handle;
+        points[signal_count++] = publish->point;
+    }
+
+    drmsync_signal_points( handles, points, signal_count );
+}
