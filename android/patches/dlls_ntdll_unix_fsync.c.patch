+static inline void try_yield_to_waiters( int prev_pid )
+{
+    if (!fsync_yield_to_waiters) return;
+
+    /* A woken fsync waiter can lose the object to the signaling thread.
+     * Yield only for a waiter in this process; stale PIDs and concurrent waiters
+     * make last_pid a best-effort hint. */
+
+    if (prev_pid == current_pid)
+        usleep(0);
+}
