+    if (!count) return;
+    memset( &signal, 0, sizeof(signal) );
+    signal.handles = (uintptr_t)handles;
+    signal.points = (uintptr_t)points;
+    signal.count_handles = count;
+    if (drmsync_ioctl_retry( drmsync_fd, DRMSYNC_IOCTL_TIMELINE_SIGNAL, &signal ) == -1)
+    {
+        ERR( "DRM_IOCTL_SYNCOBJ_TIMELINE_SIGNAL failed: %s.\n", strerror(errno) );
+        abort();
+    }
+}
